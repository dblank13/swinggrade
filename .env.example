# Copy to .env and edit. run.sh loads it.

# Where pose estimation runs: auto (Modal if set up and under budget, else this CPU) | modal | local
POSE_BACKEND=auto

# Modal GPU worker (free Starter plan includes $30/month of credit)
MODAL_GPU=L4                      # T4 is cheaper, L4 is faster; both are plenty for RTMPose
MODAL_MONTHLY_BUDGET_USD=25       # app stops using Modal once its own estimate reaches this; leave headroom under $30
MODAL_SCALEDOWN_S=15              # idle seconds before the GPU container shuts down (idle time is billed)

# Local CPU pose model: lightweight (RTMPose-s, fastest) | balanced (RTMPose-m) | performance (RTMPose-x)
LOCAL_POSE_MODE=balanced

MAX_HEIGHT=720                    # frames are downscaled to this height before pose estimation
MAX_CLIP_SECONDS=12               # longer clips are cut; trim to one swing
MAX_UPLOAD_MB=200
UPLOAD_TTL_MIN=60                 # uploaded videos are deleted after this many minutes

HOST=0.0.0.0
PORT=8000
